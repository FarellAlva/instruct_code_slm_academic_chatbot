# Adita RAG Environment Configuration Example
# Copy this file to .env and adjust values as needed.

# Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Model Selection & Privacy Policy:
# 1. "gemma4:31b-cloud": Default cloud model. High reasoning accuracy, but queries and
#    context are transmitted to remote Ollama Cloud servers (https://ollama.com:443).
#    Do not use if processing confidential student/academic data.
# 2. Local Models ("gemma2:2b", "qwen3:1.7b", "llama3.2:1b"): Run 100% on local hardware
#    without sending any data across the network. Recommended for strict privacy.
DEFAULT_MODEL=gemma4:31b-cloud

# Inference parameters
DEFAULT_TEMPERATURE=0.4
DEFAULT_MAX_TOKENS=768
DEFAULT_NUM_CTX=4096

# Context token budget
MAX_CONTEXT_TOKENS=2500
MAX_HISTORY_TURNS=6
MAX_HISTORY_TOKENS=500

# Security & Rate Limiting
MAX_INPUT_CHARS=500
RATE_LIMIT_PER_MINUTE=10
RESPONSE_LANGUAGE=id
